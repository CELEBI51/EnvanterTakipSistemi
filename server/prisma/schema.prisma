generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  it_staff
}


enum HardwareStatus {
  Hazir        @map("Hazır")
  Kullanimda   @map("Kullanımda")
  Arizali      @map("Arızalı")
  Serviste     @map("Serviste")
  KullanimDisi @map("Kullanım Dışı")
}

enum AssignmentStatus {
  Aktif
  KismiIade  @map("Kısmi İade")
  IadeEdildi @map("İade Edildi")
}

enum LicensePaymentType {
  KREDI_KARTI @map("Kredi Kartı")
  NAKIT       @map("Nakit")
  VADELI      @map("Vadeli")
}

enum LicenseStatus {
  AKTIF          @map("Aktif")
  YENILENDI      @map("Yenilendi")
  YENILENMEDI    @map("Yenilenmedi")
  YENILENMEYECEK @map("Yenilenmeyecek")
  IPTAL_EDILDI   @map("İptal Edildi")
  SURESI_DOLDU   @map("Süresi Doldu")
}

enum CategoryParentType {
  AKSESUAR     @map("Aksesuar")
  VARLIK       @map("Varlık")
  SARF_MALZEME @map("Sarf Malzeme")
  BILESEN      @map("Bileşen")
  LISANS       @map("Lisans")
}

enum AttachmentEntityType {
  hardware
  accessory
  license
  consumable
  component
  assignment
  return
}

enum AttachmentFileType {
  invoice
  signed_form
}

enum StockMovementEntityType {
  hardware   @map("hardware")
  accessory  @map("accessory")
  consumable @map("consumable")
  component  @map("component")
  license    @map("license")
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  fullName           String   @map("full_name")
  email              String   @unique
  phone              String?  @map("phone")
  passwordHash       String   @map("password_hash")
  role               Role
  permissions        String[] @default([])
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")

  passwordResetTokens    PasswordResetToken[]
  emailVerificationCodes EmailVerificationCode[]

  createdHardware       Hardware[]
  createdAssignments    Assignment[]
  createdAccessories    Accessory[]
  createdStockMovements StockMovement[]
  uploadedAttachments   Attachment[]
  createdLicenses       License[]
  createdConsumables    Consumable[]
  createdComponents     Component[]
  createdMaintenances   MaintenanceRecord[]
  systemLogs            SystemLog[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([userId])
}

model EmailVerificationCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  newEmail  String    @map("new_email")
  code      String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
  @@index([userId])
}

model Employee {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name")
  tcNo      String   @unique @map("tc_no") @db.Char(11)
  unitId    String   @map("unit_id") @db.Uuid
  unit      Unit     @relation(fields: [unitId], references: [id])
  phone     String?
  email     String?
  isActive        Boolean   @default(true) @map("is_active")
  hireDate        DateTime? @map("hire_date")
  terminationDate DateTime? @map("termination_date")
  createdAt       DateTime  @default(now()) @map("created_at")

  assignments    Assignment[]
  stockMovements StockMovement[]

  @@index([tcNo])
  @@index([unitId])
  @@map("employees")
}

model Category {
  id         String             @id @default(uuid()) @db.Uuid
  parentType CategoryParentType @map("parent_type")
  name       String
  createdAt  DateTime           @default(now()) @map("created_at")

  hardware    Hardware[]
  accessories Accessory[]
  consumables Consumable[]
  components  Component[]

  @@unique([parentType, name])
  @@index([parentType])
  @@map("categories")
}

model Hardware {
  id                String            @id @default(uuid()) @db.Uuid
  categoryId        String            @map("category_id") @db.Uuid
  category          Category          @relation(fields: [categoryId], references: [id])
  brand             String
  model             String?
  serialNo          String            @map("serial_no")
  demirbasNo        String            @unique @map("demirbas_no")
  wifiMacAddress    String?           @map("wifi_mac_address")
  location          String?           @map("location")
  supplier          String?           @map("supplier")
  invoiceNo         String?           @map("invoice_no")
  purchaseDate      DateTime?         @map("purchase_date")
  purchaseAmount    Decimal?          @map("purchase_amount") @db.Decimal(12, 2)
  specs             Json?             @db.JsonB
  status            HardwareStatus    @default(Hazir)
  warrantyStartDate DateTime?         @map("warranty_start_date")
  warrantyEndDate   DateTime?         @map("warranty_end_date")
  createdById       String            @map("created_by") @db.Uuid
  createdBy         User              @relation(fields: [createdById], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  assignmentItems AssignmentItem[]
  returnItems     ReturnItem[]
  maintenances    MaintenanceRecord[]

  @@index([status])
  @@index([categoryId])
  @@map("hardware")
}

model License {
  id            String             @id @default(uuid()) @db.Uuid
  unitId        String             @map("unit_id") @db.Uuid
  unit          Unit               @relation(fields: [unitId], references: [id])
  brand         String
  productInfo   String             @map("product_info")
  licenseKey    String?            @map("license_key")
  startDate     DateTime           @map("start_date")
  endDate       DateTime           @map("end_date")
  paymentType   LicensePaymentType @map("payment_type")
  status        LicenseStatus      @default(AKTIF)
  invoiceNumber String?            @map("invoice_number")
  invoiceAmount Decimal?           @map("invoice_amount") @db.Decimal(12, 2)
  notes         String?            @db.Text
  createdById   String             @map("created_by") @db.Uuid
  createdBy     User               @relation(fields: [createdById], references: [id])
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([endDate])
  @@index([status])
  @@map("licenses")
}

model Assignment {
  id                     String           @id @default(uuid()) @db.Uuid
  teslimEden             String           @map("teslim_eden")
  employeeId             String           @map("employee_id") @db.Uuid
  employee               Employee         @relation(fields: [employeeId], references: [id])
  teslimTarihi           DateTime         @map("teslim_tarihi")
  status                 AssignmentStatus @default(Aktif)
  pdfUrl                 String?          @map("pdf_url")
  pdfPath                String?          @map("pdf_path") @db.Text
  signedFormAttachmentId String?          @map("signed_form_attachment_id") @db.Uuid
  signedFormAttachment   Attachment?      @relation("SignedFormAttachment", fields: [signedFormAttachmentId], references: [id])
  createdById            String           @map("created_by") @db.Uuid
  createdBy              User             @relation(fields: [createdById], references: [id])
  createdAt              DateTime         @default(now()) @map("created_at")

  items           AssignmentItem[]
  accessoryItems  AssignmentAccessoryItem[]
  consumableItems AssignmentConsumableItem[]
  returns         Return[]

  @@index([employeeId])
  @@index([status])
  @@map("assignments")
}

model AssignmentItem {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  hardwareId   String     @map("hardware_id") @db.Uuid
  hardware     Hardware   @relation(fields: [hardwareId], references: [id])
  returned     Boolean    @default(false)
  returnDate   DateTime?  @map("return_date")

  @@map("assignment_items")
}

model AssignmentAccessoryItem {
  id               String     @id @default(uuid()) @db.Uuid
  assignmentId     String     @map("assignment_id") @db.Uuid
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  accessoryId      String     @map("accessory_id") @db.Uuid
  accessory        Accessory  @relation(fields: [accessoryId], references: [id])
  quantityGiven    Int        @map("quantity_given")
  quantityReturned Int        @default(0) @map("quantity_returned")

  @@index([assignmentId])
  @@index([accessoryId])
  @@map("assignment_accessory_items")
}

model AssignmentConsumableItem {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  consumableId String     @map("consumable_id") @db.Uuid
  consumable   Consumable @relation(fields: [consumableId], references: [id])
  quantityGiven Int       @map("quantity_given")

  @@index([assignmentId])
  @@index([consumableId])
  @@map("assignment_consumable_items")
}

model Return {
  id                     String      @id @default(uuid()) @db.Uuid
  assignmentId           String      @map("assignment_id") @db.Uuid
  assignment             Assignment  @relation(fields: [assignmentId], references: [id])
  teslimAlanIc           String      @map("teslim_alan_ic")
  tarih                  DateTime
  notes                  String?
  pdfPath                String?     @map("pdf_path") @db.Text
  signedFormAttachmentId String?     @map("signed_form_attachment_id") @db.Uuid
  signedFormAttachment   Attachment? @relation("SignedFormReturnAttachment", fields: [signedFormAttachmentId], references: [id])
  createdAt              DateTime    @default(now()) @map("created_at")

  items          ReturnItem[]
  accessoryItems ReturnAccessoryItem[]

  @@map("returns")
}

model ReturnItem {
  id           String         @id @default(uuid()) @db.Uuid
  returnId     String         @map("return_id") @db.Uuid
  return       Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  hardwareId   String         @map("hardware_id") @db.Uuid
  hardware     Hardware       @relation(fields: [hardwareId], references: [id])
  resultStatus HardwareStatus @map("result_status")

  @@map("return_items")
}

model ReturnAccessoryItem {
  id               String     @id @default(uuid()) @db.Uuid
  returnId         String     @map("return_id") @db.Uuid
  return           Return     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  accessoryId      String     @map("accessory_id") @db.Uuid
  accessory        Accessory  @relation(fields: [accessoryId], references: [id])
  quantityReturned Int        @map("quantity_returned")
  resultStatus     String?    @map("result_status")

  @@index([returnId])
  @@index([accessoryId])
  @@map("return_accessory_items")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  relatedId String?  @map("related_id")
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Accessory {
  id                String                    @id @default(uuid()) @db.Uuid
  name              String
  categoryId        String                    @map("category_id") @db.Uuid
  category          Category                  @relation(fields: [categoryId], references: [id])
  brand             String?
  supplier          String?                   @map("supplier")
  invoiceNo         String?                   @map("invoice_no")
  purchaseDate      DateTime?                 @map("purchase_date")
  purchaseAmount    Decimal?                  @map("purchase_amount") @db.Decimal(12, 2)
  totalQuantity     Int                       @default(0) @map("total_quantity")
  availableQuantity Int                       @default(0) @map("available_quantity")
  assignedQuantity  Int                       @default(0) @map("assigned_quantity")
  outOfUseQuantity  Int                       @default(0) @map("out_of_use_quantity")
  minThreshold      Int?                      @map("min_threshold")
  notes             String?                   @db.Text
  createdById       String                    @map("created_by") @db.Uuid
  createdBy         User                      @relation(fields: [createdById], references: [id])
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  assignmentItems   AssignmentAccessoryItem[]
  returnItems       ReturnAccessoryItem[]

  @@index([categoryId])
  @@map("accessories")
}

model Consumable {
  id                String                     @id @default(uuid()) @db.Uuid
  name              String
  categoryId        String                     @map("category_id") @db.Uuid
  category          Category                   @relation(fields: [categoryId], references: [id])
  manufacturer      String?
  supplier          String?
  location          String?
  totalQuantity     Int                        @default(0) @map("total_quantity")
  availableQuantity Int                        @default(0) @map("available_quantity")
  consumedQuantity  Int                        @default(0) @map("consumed_quantity")
  invoiceNo         String?                    @map("invoice_no")
  purchaseDate      DateTime?                  @map("purchase_date")
  purchaseAmount    Decimal?                   @map("purchase_amount") @db.Decimal(12, 2)
  notes             String?                    @db.Text
  createdById       String                     @map("created_by") @db.Uuid
  createdBy         User                       @relation(fields: [createdById], references: [id])
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  assignmentItems   AssignmentConsumableItem[]

  @@index([categoryId])
  @@map("consumables")
}

model Component {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  categoryId            String                 @map("category_id") @db.Uuid
  category              Category               @relation(fields: [categoryId], references: [id])
  brand                 String?
  model                 String?
  location              String?
  supplier              String?
  totalQuantity         Int                    @default(0) @map("total_quantity")
  availableQuantity     Int                    @default(0) @map("available_quantity")
  usedQuantity          Int                    @default(0) @map("used_quantity")
  invoiceNo             String?                @map("invoice_no")
  purchaseDate          DateTime?              @map("purchase_date")
  purchaseAmount        Decimal?               @map("purchase_amount") @db.Decimal(12, 2)
  notes                 String?                @db.Text
  createdById           String                 @map("created_by") @db.Uuid
  createdBy             User                   @relation(fields: [createdById], references: [id])
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  maintenanceComponents MaintenanceComponent[]

  @@index([categoryId])
  @@map("components")
}

model StockMovement {
  id                 String                  @id @default(uuid()) @db.Uuid
  entityType         StockMovementEntityType @map("entity_type")
  entityId           String                  @map("entity_id") @db.Uuid
  type               String
  quantity           Int
  note               String?                 @db.Text
  issuedToEmployeeId String?                 @map("issued_to_employee_id") @db.Uuid
  issuedToEmployee   Employee?               @relation(fields: [issuedToEmployeeId], references: [id])
  createdById        String                  @map("created_by") @db.Uuid
  createdBy          User                    @relation(fields: [createdById], references: [id])
  createdAt          DateTime                @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("stock_movements")
}

model Attachment {
  id           String               @id @default(uuid()) @db.Uuid
  entityType   AttachmentEntityType @map("entity_type")
  entityId     String               @map("entity_id") @db.Uuid
  fileType     AttachmentFileType   @map("file_type")
  filePath     String               @map("file_path")
  originalName String?              @map("original_name")
  uploadedById String?              @map("uploaded_by") @db.Uuid
  uploadedBy   User?                @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime             @default(now()) @map("created_at")

  signedFormAssignments Assignment[] @relation("SignedFormAttachment")
  signedFormReturns     Return[]     @relation("SignedFormReturnAttachment")

  @@index([entityType, entityId])
  @@map("attachments")
}

model MaintenanceRecord {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String
  hardwareId             String    @map("hardware_id") @db.Uuid
  hardware               Hardware  @relation(fields: [hardwareId], references: [id])
  maintenanceType        String    @map("maintenance_type")
  customTypeNote         String?   @map("custom_type_note") @db.Text
  startDate              DateTime  @map("start_date")
  endDate                DateTime? @map("end_date")
  cost                   Decimal?  @db.Decimal(10, 2)
  notes                  String?   @db.Text
  status                 String    @default("Devam Ediyor")
  previousHardwareStatus String    @map("previous_hardware_status")
  appliedResultStatus    String?   @map("applied_result_status")
  createdById            String    @map("created_by") @db.Uuid
  createdBy              User      @relation(fields: [createdById], references: [id])
  createdAt              DateTime  @default(now()) @map("created_at")

  components MaintenanceComponent[]

  @@index([hardwareId])
  @@index([status])
  @@map("maintenance_records")
}

model MaintenanceComponent {
  id            String            @id @default(uuid()) @db.Uuid
  maintenanceId String            @map("maintenance_id") @db.Uuid
  maintenance   MaintenanceRecord @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  componentId   String            @map("component_id") @db.Uuid
  component     Component         @relation(fields: [componentId], references: [id])
  quantityUsed  Int               @map("quantity_used")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([maintenanceId])
  @@index([componentId])
  @@map("maintenance_components")
}

model Unit {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  address       String?
  phone         String?
  contactPerson String?  @map("contact_person")
  email         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employees Employee[]
  licenses  License[]

  @@map("units")
}

model SystemSettings {
  id                     Int      @id @default(1)
  companyName            String   @default("") @map("company_name")
  companyAddress         String?  @map("company_address")
  companyPhone           String?  @map("company_phone")
  companyEmail           String?  @map("company_email")
  companyTaxNo           String?  @map("company_tax_no")
  logoPath               String?  @map("logo_path")
  criticalStockThreshold Int      @default(5) @map("critical_stock_threshold")
  licenseWarningDays     Int      @default(15) @map("license_warning_days")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  subject   String
  bodyText  String   @map("body_text") @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model SystemLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])
  userEmail   String?  @map("user_email")
  action      String
  module      String
  description String   @db.Text
  entityId    String?  @map("entity_id")
  ipAddress   String?  @map("ip_address")
  statusCode  Int?     @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@index([module])
  @@map("system_logs")
}

