# ------------------------------------------------------------------
# Entanter Takip - API ortam degiskenleri
# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# .env ASLA git'e commit EDILMEZ.
# ------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# --- Veritabani -----------------------------------------------------
DATABASE_URL=postgresql://entanter:DEGISTIR@localhost:5432/entanter_takip
DB_POOL_MAX=10

# --- Kimlik dogrulama ----------------------------------------------
# Uretimde rastgele uretin (deploy/scripts/02-configure.ps1 bunu otomatik yapar):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=en-az-32-karakterlik-rastgele-bir-deger-girin
JWT_REFRESH_SECRET=baska-bir-en-az-32-karakterlik-rastgele-deger
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS -----------------------------------------------------------
# Frontend ayri portta calistigi icin TAM ESLESMELI origin listesi zorunlu.
# Wildcard (*) credentials ile birlikte calismaz.
# Uretimde ornek: http://192.168.1.50:3000
CORS_ORIGINS=http://localhost:3000

# Intranette TLS yoksa false birakin; cookie'nin Secure bayragini kontrol eder.
USE_HTTPS=false

# --- Loglama --------------------------------------------------------
LOG_LEVEL=info

# --- Ilk kurulum (seed) ---------------------------------------------
# SEED_ADMIN_PASSWORD verilmezse seed rastgele parola uretip ekrana yazar.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULLNAME=Sistem Yoneticisi
