# API adresi. Frontend ve API AYRI servisler olarak calisir.
# Gelistirme:
VITE_API_URL=http://localhost:3001
#
# Uretim ornegi (fabrika sunucusunun yerel ag adresi):
# VITE_API_URL=http://192.168.1.50:3001
#
# NOT: Bu deger BUILD sirasinda gomulur. Sunucu adresi degisirse
# frontend yeniden build edilmelidir (deploy/scripts/02-configure.ps1 uyarir).
