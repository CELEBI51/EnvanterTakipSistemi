{
  "name": "entanter-takip",
  "version": "1.0.0",
  "private": true,
  "description": "Fabrika ici Envanter ve Zimmet Takip Sistemi (offline / intranet)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @entanter/shared && npm run build -w @entanter/api && npm run build -w @entanter/web",
    "dev:api": "npm run dev -w @entanter/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @entanter/api",
    "db:migrate": "npm run db:migrate -w @entanter/api",
    "db:seed": "npm run db:seed -w @entanter/api",
    "build:deploy": "node scripts/build-deploy.mjs",
    "smoke": "npm run smoke -w @entanter/api --",
    "dev:db": "npm run dev:db -w @entanter/api",
    "dev:web": "npm run dev -w @entanter/web"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
